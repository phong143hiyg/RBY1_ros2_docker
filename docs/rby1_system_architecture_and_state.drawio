<mxfile host="app.diagrams.net" modified="2026-08-18T00:00:00.000Z" agent="Codex" version="26.0.14" type="device" compressed="false">
  <diagram id="architecture-rby1" name="1. Kiến trúc hệ thống">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="RB-Y1 Local Controller — Kiến trúc hệ thống" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="850" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Mũi tên ghi rõ giao thức/API. Tất cả container dùng host network, Fast DDS và ROS_DOMAIN_ID = 0." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="32" y="54" width="1050" height="26" as="geometry"/></mxCell>

        <mxCell id="clientGroup" value="Người dùng &amp; ứng dụng điều khiển" style="swimlane;html=1;startSize=30;rounded=1;horizontal=1;fillColor=#F5F5F5;swimlaneFillColor=#EDEDED;strokeColor=#666666;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="105" width="280" height="610" as="geometry"/></mxCell>
        <mxCell id="browser" value="&lt;b&gt;Trình duyệt&lt;/b&gt;&lt;br&gt;Web UI&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Người vận hành&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" vertex="1" parent="clientGroup"><mxGeometry x="30" y="80" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="desktop" value="&lt;b&gt;Desktop Qt Controller&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Ứng dụng ở repository riêng&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" vertex="1" parent="clientGroup"><mxGeometry x="30" y="270" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="operator" value="&lt;b&gt;Người vận hành&lt;/b&gt;&lt;br&gt;Mở UI, gửi lệnh và giám sát" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="clientGroup"><mxGeometry x="30" y="460" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="opBrowser" value="Thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F6000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="clientGroup" source="operator" target="browser"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="opDesktop" value="Thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F6000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="clientGroup" source="operator" target="desktop"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="webContainer" value="Docker container: rby1-web" style="swimlane;html=1;startSize=30;rounded=1;horizontal=1;fillColor=#FCE4D6;swimlaneFillColor=#F8CBAD;strokeColor=#B45F06;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="390" y="105" width="325" height="610" as="geometry"/></mxCell>
        <mxCell id="fastapi" value="&lt;b&gt;FastAPI + static Web UI&lt;/b&gt;&lt;br&gt;server.py :8000&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Xác thực dữ liệu, REST API, WebSocket&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FCE4D6;strokeColor=#B45F06;fontSize=15;" vertex="1" parent="webContainer"><mxGeometry x="30" y="70" width="265" height="100" as="geometry"/></mxCell>
        <mxCell id="webBridge" value="&lt;b&gt;ROS 2 node: rby1_web_bridge&lt;/b&gt;&lt;br&gt;Chuyển HTTP/WebSocket ↔ ROS 2&lt;br&gt;Watchdog vận tốc 20 Hz" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;" vertex="1" parent="webContainer"><mxGeometry x="30" y="250" width="265" height="100" as="geometry"/></mxCell>
        <mxCell id="webSafety" value="&lt;b&gt;Bảo vệ tại web bridge&lt;/b&gt;&lt;br&gt;• Giới hạn: ±0,20 m/s; ±0,50 rad/s&lt;br&gt;• Không có lệnh &gt; 350 ms → Twist = 0&lt;br&gt;• WebSocket ngắt → dừng đế" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E2F0D9;strokeColor=#82B366;fontSize=13;" vertex="1" parent="webContainer"><mxGeometry x="30" y="430" width="265" height="125" as="geometry"/></mxCell>
        <mxCell id="fastapiBridge" value="Lời gọi nội bộ Python" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B45F06;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="webContainer" source="fastapi" target="webBridge"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="bridgeContainer" value="Docker container: rby1-app-bridge" style="swimlane;html=1;startSize=30;rounded=1;horizontal=1;fillColor=#E1D5E7;swimlaneFillColor=#D5A6BD;strokeColor=#9673A6;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="785" y="105" width="325" height="610" as="geometry"/></mxCell>
        <mxCell id="tcpServer" value="&lt;b&gt;TCP server :8081&lt;/b&gt;&lt;br&gt;Mỗi request/response là 1 dòng JSON&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Nhận lệnh desktop&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;" vertex="1" parent="bridgeContainer"><mxGeometry x="30" y="70" width="265" height="100" as="geometry"/></mxCell>
        <mxCell id="appBridge" value="&lt;b&gt;ROS 2 node: rby1_app_bridge&lt;/b&gt;&lt;br&gt;C++ / rclcpp + Boost.Asio&lt;br&gt;Chuyển TCP JSON ↔ ROS 2" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;" vertex="1" parent="bridgeContainer"><mxGeometry x="30" y="250" width="265" height="100" as="geometry"/></mxCell>
        <mxCell id="appSafety" value="&lt;b&gt;Bảo vệ tại TCP bridge&lt;/b&gt;&lt;br&gt;• 350 ms không có velocity → Twist = 0&lt;br&gt;• Chặn khi collision / E-stop / joint busy&lt;br&gt;• Ready pose lưu 22 khớp trong phiên" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E2F0D9;strokeColor=#82B366;fontSize=13;" vertex="1" parent="bridgeContainer"><mxGeometry x="30" y="430" width="265" height="125" as="geometry"/></mxCell>
        <mxCell id="tcpApp" value="Parser lệnh / phản hồi JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="bridgeContainer" source="tcpServer" target="appBridge"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="rosContainer" value="Docker container: rby1-ros2" style="swimlane;html=1;startSize=30;rounded=1;horizontal=1;fillColor=#D9EAD3;swimlaneFillColor=#B6D7A8;strokeColor=#6AA84F;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1180" y="105" width="360" height="610" as="geometry"/></mxCell>
        <mxCell id="driver" value="&lt;b&gt;RB-Y1 ROS 2 Driver&lt;/b&gt;&lt;br&gt;rby1_driver + rby1-sdk&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Action/service server, topic publisher&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D9EAD3;strokeColor=#6AA84F;fontSize=15;" vertex="1" parent="rosContainer"><mxGeometry x="40" y="75" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="driverApi" value="&lt;b&gt;ROS 2 interface /rby1&lt;/b&gt;&lt;br&gt;Topics · Services · Action&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;DDS discovery &amp; data transport&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F3F9F1;strokeColor=#6AA84F;fontSize=14;" vertex="1" parent="rosContainer"><mxGeometry x="40" y="270" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="sdk" value="&lt;b&gt;RB-Y1 SDK&lt;/b&gt;&lt;br&gt;Kết nối driver với robot/simulator" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E2F0D9;strokeColor=#82B366;fontSize=14;" vertex="1" parent="rosContainer"><mxGeometry x="40" y="450" width="280" height="75" as="geometry"/></mxCell>
        <mxCell id="driverSdk" value="API SDK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6AA84F;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="rosContainer" source="driver" target="sdk"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="simContainer" value="Docker container: rby1-sim" style="swimlane;html=1;startSize=30;rounded=1;horizontal=1;fillColor=#D9D2E9;swimlaneFillColor=#C9DAF8;strokeColor=#6D9EEB;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1180" y="755" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="sim" value="&lt;b&gt;MuJoCo RB-Y1 simulator&lt;/b&gt;&lt;br&gt;Mô phỏng robot; hiển thị qua X11" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D9D2E9;strokeColor=#6D9EEB;fontSize=15;" vertex="1" parent="simContainer"><mxGeometry x="40" y="48" width="280" height="65" as="geometry"/></mxCell>

        <mxCell id="httpRequest" value="HTTP/JSON :8000&lt;br&gt;REST: /api/prepare, /velocity, /joints/*, /stop, /cancel…" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B45F06;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="browser" target="fastapi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="httpStatic" value="HTTP :8000&lt;br&gt;HTML / CSS / JavaScript" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=none;strokeColor=#B45F06;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="browser" target="fastapi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="230"/><mxPoint x="350" y="260"/></Array></mxGeometry></mxCell>
        <mxCell id="wsStatus" value="WebSocket /ws/status&lt;br&gt;JSON trạng thái mỗi ~100 ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#00A2E8;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="browser" target="fastapi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="360"/><mxPoint x="350" y="430"/></Array></mxGeometry></mxCell>
        <mxCell id="tcpJson" value="TCP :8081 / NDJSON&lt;br&gt;command + response JSON (1 dòng)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="desktop" target="tcpServer"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="webCmdVel" value="ROS 2 topic /rby1/cmd_vel&lt;br&gt;geometry_msgs/Twist · 20 Hz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#CC0000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="webBridge" target="driverApi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="395"/><mxPoint x="1140" y="395"/></Array></mxGeometry></mxCell>
        <mxCell id="appCmdVel" value="ROS 2 topic /rby1/cmd_vel&lt;br&gt;geometry_msgs/Twist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#CC0000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="appBridge" target="driverApi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="445"/></Array></mxGeometry></mxCell>
        <mxCell id="webServices" value="ROS 2 services&lt;br&gt;StateOnOff: robot_power, robot_servo, stream_control&lt;br&gt;Trigger: cancel_control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#E69138;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="webBridge" target="driverApi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="470"/><mxPoint x="1140" y="470"/></Array></mxGeometry></mxCell>
        <mxCell id="appServices" value="ROS 2 services&lt;br&gt;StateOnOff / Trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#E69138;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="appBridge" target="driverApi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="520"/></Array></mxGeometry></mxCell>
        <mxCell id="webAction" value="ROS 2 action /rby1/robot_joint&lt;br&gt;rby1_msgs/Rby1JointCommand (goal / feedback / result)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#674EA7;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="webBridge" target="driverApi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="575"/><mxPoint x="1140" y="575"/></Array></mxGeometry></mxCell>
        <mxCell id="appAction" value="ROS 2 action /rby1/robot_joint&lt;br&gt;Rby1JointCommand" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#674EA7;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="appBridge" target="driverApi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="630"/></Array></mxGeometry></mxCell>
        <mxCell id="webTopics" value="ROS 2 topics (DDS)&lt;br&gt;/robot_state: RobotState · /odom: Odometry&lt;br&gt;/joint_states [+ torso/right_arm/left_arm/head]: JointState" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=none;strokeColor=#38761D;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="webBridge" target="driverApi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="665"/><mxPoint x="1140" y="665"/></Array></mxGeometry></mxCell>
        <mxCell id="appTopics" value="ROS 2 topics (DDS)&lt;br&gt;RobotState + JointState" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=none;strokeColor=#38761D;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="appBridge" target="driverApi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="705"/></Array></mxGeometry></mxCell>
        <mxCell id="sdkSim" value="Môi trường mô phỏng RB-Y1&lt;br&gt;(driver/SDK điều khiển simulator)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#6D9EEB;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sdk" target="sim"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="legend" value="&lt;b&gt;Chú giải màu&lt;/b&gt;  Đỏ: vận tốc / chuyển động đế · Cam: service bật/tắt/hủy · Tím: action điều khiển khớp · Xanh lá: topic trạng thái · Xanh dương: WebSocket" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#999999;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="745" width="1075" height="56" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;Luồng điều khiển an toàn:&lt;/b&gt; Trình duyệt/Qt → bridge tương ứng → ROS 2 driver → simulator. Trạng thái đi theo chiều ngược lại; bridge chỉ cho phép chuyển động khi robot đã kết nối, control manager ENABLE/EXECUTING, stream ON và không có điều kiện chặn." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="820" width="1075" height="85" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="state-rby1" name="2. Chuyển trạng thái">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="stTitle" value="RB-Y1 Local Controller — Sơ đồ chuyển trạng thái vận hành" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="980" height="40" as="geometry"/></mxCell>
        <mxCell id="stSubtitle" value="Đây là trạng thái logic nhìn từ bridge/controller. Các mũi tên chứa sự kiện API hoặc điều kiện xác nhận từ /rby1/robot_state." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="32" y="54" width="1200" height="26" as="geometry"/></mxCell>

        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="75" y="214" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="disconnected" value="&lt;b&gt;MẤT KẾT NỐI&lt;/b&gt;&lt;br&gt;Không có /rby1/robot_state&lt;br&gt;hoặc bản tin cũ &gt; 1,5 s&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Không được gửi lệnh điều khiển&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F4CCCC;strokeColor=#CC0000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="160" y="150" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="connected" value="&lt;b&gt;ĐÃ KẾT NỐI / CHƯA SẴN SÀNG&lt;/b&gt;&lt;br&gt;Nhận RobotState từ driver&lt;br&gt;Stream OFF hoặc control manager&lt;br&gt;chưa ENABLE/EXECUTING" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D9EAD3;strokeColor=#6AA84F;fontSize=15;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="preparing" value="&lt;b&gt;ĐANG CHUẨN BỊ&lt;/b&gt;&lt;br&gt;Bridge thực hiện chuỗi an toàn:&lt;br&gt;1. power ON → 2. servo ON&lt;br&gt;3. chờ ENABLE → 4. stream ON" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="910" y="150" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="ready" value="&lt;b&gt;SẴN SÀNG (READY)&lt;/b&gt;&lt;br&gt;Điều kiện:&lt;br&gt;• Đã kết nối; manager ENABLE/EXECUTING&lt;br&gt;• Stream ON; không có action khớp đang chạy&lt;br&gt;• Không collision / E-stop" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D9EAD3;strokeColor=#38761D;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1280" y="150" width="285" height="125" as="geometry"/></mxCell>

        <mxCell id="driving" value="&lt;b&gt;ĐANG LÁI ĐẾ (DRIVING)&lt;/b&gt;&lt;br&gt;Bridge publish /rby1/cmd_vel&lt;br&gt;geometry_msgs/Twist tại 20 Hz&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Giữ trạng thái khi tiếp tục nhận velocity&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#3D85C6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1210" y="450" width="285" height="115" as="geometry"/></mxCell>
        <mxCell id="joint" value="&lt;b&gt;ĐANG ĐIỀU KHIỂN KHỚP&lt;/b&gt;&lt;br&gt;1. Dừng đế; tắt stream tạm thời&lt;br&gt;2. Gửi /rby1/robot_joint action&lt;br&gt;3. Nhận feedback / result; khôi phục stream" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAD1DC;strokeColor=#A64D79;fontSize=15;" vertex="1" parent="1"><mxGeometry x="760" y="450" width="315" height="115" as="geometry"/></mxCell>
        <mxCell id="fault" value="&lt;b&gt;LỖI / DỪNG KHẨN&lt;/b&gt;&lt;br&gt;collision, E-stop hoặc Control Manager&lt;br&gt;major/minor fault&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Cấm lệnh vận tốc; cần xử lý nguyên nhân&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F4CCCC;strokeColor=#CC0000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="cancelled" value="&lt;b&gt;ĐÃ HỦY / DỪNG AN TOÀN&lt;/b&gt;&lt;br&gt;Twist = 0; action đang chạy bị hủy&lt;br&gt;cancel_control đóng stream&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Cần bật stream/Prepare để lái lại&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FCE4D6;strokeColor=#B45F06;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="520" width="270" height="115" as="geometry"/></mxCell>

        <mxCell id="startToDisc" value="Khởi động service/container" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="start" target="disconnected"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="discToConnected" value="Nhận /rby1/robot_state&lt;br&gt;trong &lt; 1,5 s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#38761D;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="disconnected" target="connected"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="connectedToPrep" value="POST /api/prepare&lt;br&gt;hoặc lệnh prepare (TCP JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#E69138;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="connected" target="preparing"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="prepToReady" value="Services thành công + RobotState xác nhận&lt;br&gt;ENABLE/EXECUTING và stream ON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#38761D;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="preparing" target="ready"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="readyToDrive" value="POST /api/velocity&lt;br&gt;hoặc velocity TCP JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3D85C6;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ready" target="driving"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="driveToReady" value="POST /api/stop; velocity = 0&lt;br&gt;hoặc &gt; 350 ms không có lệnh / WebSocket ngắt&lt;br&gt;→ watchdog publish Twist = 0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3D85C6;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="driving" target="ready"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1535" y="360"/><mxPoint x="1535" y="330"/></Array></mxGeometry></mxCell>
        <mxCell id="readyToJoint" value="POST /api/joints/nudge|pose|ready|zero&lt;br&gt;hoặc lệnh khớp TCP JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#A64D79;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ready" target="joint"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="jointToReady" value="Action thành công/thất bại → khôi phục stream&lt;br&gt;và không có lỗi an toàn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#A64D79;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="joint" target="ready"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="365"/><mxPoint x="1270" y="365"/></Array></mxGeometry></mxCell>
        <mxCell id="cancelReady" value="POST /api/cancel&lt;br&gt;hoặc cancel TCP JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B45F06;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ready" target="cancelled"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="700"/><mxPoint x="210" y="700"/></Array></mxGeometry></mxCell>
        <mxCell id="cancelDrive" value="/api/cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B45F06;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="driving" target="cancelled"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="735"/><mxPoint x="210" y="735"/></Array></mxGeometry></mxCell>
        <mxCell id="cancelJoint" value="/api/cancel: hủy goal rồi cancel_control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B45F06;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="joint" target="cancelled"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="735"/><mxPoint x="210" y="735"/></Array></mxGeometry></mxCell>
        <mxCell id="cancelToConnected" value="RobotState còn nhận được&lt;br&gt;(stream OFF)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B45F06;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cancelled" target="connected"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="350"/><mxPoint x="650" y="350"/></Array></mxGeometry></mxCell>

        <mxCell id="toFault1" value="RobotState: collision / E-stop /&lt;br&gt;Control Manager major/minor fault" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#CC0000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ready" target="fault"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="410"/><mxPoint x="555" y="410"/></Array></mxGeometry></mxCell>
        <mxCell id="toFault2" value="Điều kiện lỗi an toàn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#CC0000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="driving" target="fault"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="610"/><mxPoint x="720" y="610"/></Array></mxGeometry></mxCell>
        <mxCell id="toFault3" value="Điều kiện lỗi an toàn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#CC0000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="joint" target="fault"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="faultToConn" value="Người vận hành xử lý lỗi/E-stop&lt;br&gt;và RobotState trở về bình thường" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#CC0000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fault" target="connected"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="380"/><mxPoint x="650" y="380"/></Array></mxGeometry></mxCell>

        <mxCell id="allToDisc" value="Từ mọi trạng thái:&lt;br&gt;/rby1/robot_state cũ &gt; 1,5 s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#666666;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ready" target="disconnected"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="820"/><mxPoint x="275" y="820"/><mxPoint x="275" y="295"/></Array></mxGeometry></mxCell>

        <mxCell id="stateNote" value="&lt;b&gt;Quy tắc chính&lt;/b&gt;&lt;br&gt;• Lái đế chỉ hợp lệ khi: connected + ENABLE/EXECUTING + stream ON + không joint busy + không collision/E-stop.&lt;br&gt;• Lệnh khớp luôn dừng đế trước, có thể tắt stream tạm thời và bật lại sau khi action kết thúc.&lt;br&gt;• /api/cancel gọi cancel_control, vì vậy stream bị đóng và hệ thống quay lại “Đã kết nối / chưa sẵn sàng”." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="790" width="680" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
